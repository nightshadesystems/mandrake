# Mandrake media build configuration.
#
# Plain KEY=value lines only: this file is sourced by build/media/*.sh on
# the build host and by the overlay hooks inside the image build, so it
# must stay free of logic and of anything host-specific.

# OmniOS release Mandrake tracks (ADR-0001). Kayak takes loader and boot
# files from the running build host, so the host must run this release.
OMNIOS_RELEASE=r151054

# Mandrake version stamped on media filenames.
MANDRAKE_VERSION=0.1.0

# IPS publisher layered on top of omnios, and its origin (ADR-0006).
MANDRAKE_PUBLISHER=nightshade.systems
MANDRAKE_PUBLISHER_URL=https://pkg.nightshade.systems/mandrake/r151054

# Repository kayak installs OmniOS packages from while building images.
# Override with PKGURL in the environment to build from a local mirror.
OMNIOS_PKGURL=https://pkg.omnios.org/r151054/core

# Loader menu title on install media. The installed system uses the title
# in branding/loader/conf.d/mandrake.
LOADER_MENU_TITLE="Welcome to the Mandrake installer"
